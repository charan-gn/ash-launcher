<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/primaryInverseColor"
    tools:context=".ui.HomeFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="20dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:id="@+id/tabBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal" />

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/homePager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/setDefaultLauncher"
            style="@style/TextSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:text="@string/set_as_default_launcher_u"
            android:textColor="?attr/primaryColorTrans80"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/statusLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/jetbrains_mono_regular"
            android:gravity="center"
            android:letterSpacing="0"
            android:textColor="?attr/primaryColorTrans50"
            android:textSize="12sp"
            tools:text="21:44 · home" />

        <TextView
            android:id="@+id/hintLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/jetbrains_mono_regular"
            android:gravity="center"
            android:letterSpacing="0"
            android:text="@string/home_hint"
            android:textColor="?attr/primaryColorTrans50"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
