<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainActivityLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/primaryInverseColor">

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/scrollLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="40dp"
            android:paddingEnd="20dp"
            android:paddingBottom="48dp">

            <TextView
                style="@style/TextLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_header"
                android:textColor="?attr/primaryColor" />

            <TextView
                style="@style/TextSmallLight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:letterSpacing="0"
                android:text="@string/settings_divider"
                android:textColor="?attr/primaryColorTrans50" />

            <TextView
                style="@style/TextSmallBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="4dp"
                android:text="@string/settings_section_launcher"
                android:textColor="?attr/primaryColor" />

            <TextView
                android:id="@+id/setLauncher"
                style="@style/TextSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:paddingVertical="10dp"
                android:text="@string/settings_prompt_set_default"
                android:textColor="?attr/primaryColor" />

            <TextView
                android:id="@+id/github"
                style="@style/TextSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:paddingVertical="10dp"
                android:text="@string/settings_prompt_source"
                android:textColor="?attr/primaryColor" />

            <TextView
                android:id="@+id/appInfo"
                style="@style/TextSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:paddingVertical="10dp"
                android:text="@string/settings_prompt_app_info"
                android:textColor="?attr/primaryColor" />

            <TextView
                style="@style/TextSmallBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="4dp"
                android:text="@string/settings_section_home"
                android:textColor="?attr/primaryColor" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextSmall"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingVertical="10dp"
                    android:text="@string/settings_pages"
                    android:textColor="?attr/primaryColor" />

                <TextView
                    android:id="@+id/pageCount"
                    style="@style/TextSmallBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:paddingStart="16dp"
                    android:paddingVertical="10dp"
                    android:textColor="?attr/primaryColor"
                    tools:text="3" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextSmall"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingVertical="10dp"
                    android:text="@string/settings_start_page"
                    android:textColor="?attr/primaryColor" />

                <TextView
                    android:id="@+id/startPage"
                    style="@style/TextSmallBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:paddingStart="16dp"
                    android:paddingVertical="10dp"
                    android:textColor="?attr/primaryColor"
                    tools:text="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextSmall"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingVertical="10dp"
                    android:text="@string/settings_splash"
                    android:textColor="?attr/primaryColor" />

                <TextView
                    android:id="@+id/asciiSplash"
                    style="@style/TextSmallBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:paddingStart="16dp"
                    android:paddingVertical="10dp"
                    android:textColor="?attr/primaryColor"
                    tools:text="on" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextSmall"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingVertical="10dp"
                    android:text="@string/settings_status_bar"
                    android:textColor="?attr/primaryColor" />

                <TextView
                    android:id="@+id/statusBar"
                    style="@style/TextSmallBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:paddingStart="16dp"
                    android:paddingVertical="10dp"
                    android:textColor="?attr/primaryColor"
                    tools:text="off" />
            </LinearLayout>

            <TextView
                style="@style/TextSmallBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="4dp"
                android:text="@string/settings_section_appearance"
                android:textColor="?attr/primaryColor" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextSmall"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingVertical="10dp"
                    android:text="@string/settings_theme"
                    android:textColor="?attr/primaryColor" />

                <TextView
                    android:id="@+id/appThemeText"
                    style="@style/TextSmallBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:paddingStart="16dp"
                    android:paddingVertical="10dp"
                    android:textColor="?attr/primaryColor"
                    tools:text="dark" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextSmall"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingVertical="10dp"
                    android:text="@string/settings_text_scale"
                    android:textColor="?attr/primaryColor" />

                <TextView
                    android:id="@+id/textSizeValue"
                    style="@style/TextSmallBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:paddingStart="16dp"
                    android:paddingVertical="10dp"
                    android:textColor="?attr/primaryColor"
                    tools:text="1.0" />
            </LinearLayout>

            <TextView
                style="@style/TextSmallLight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:letterSpacing="0"
                android:text="@string/settings_divider"
                android:textColor="?attr/primaryColorTrans50" />

            <TextView
                android:id="@+id/footer"
                style="@style/TextSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="?attr/primaryColorTrans50" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>
